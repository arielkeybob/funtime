rules_version = '2';

// Regras do FunTime. Ver docs/specs/0022 (sincronização) e 0023 (compartilhamento).
//
// Estas regras são a única coisa separando os dados de duas pessoas: não há servidor
// nem código de backend. Toda mudança aqui precisa passar por tests/firestore-rules.test.cjs
// antes de ser publicada com `npm run rules:deploy`.
//
// Princípio que atravessa tudo: compartilhar é sempre iniciado por quem é dono do
// dado. Não existe caminho para alguém PEDIR acesso — ninguém tem permissão de
// escrita em documento que outra pessoa leia como pedido.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }

    function pairIdFor(a, b) { return a < b ? a + '_' + b : b + '_' + a; }
    function codePath(code) { return /databases/$(database)/documents/pairingCodes/$(code); }
    function pairPath(other) { return /databases/$(database)/documents/pairings/$(pairIdFor(me(), other)); }

    // O código existe, pertence a quem se diz dono, e ainda não venceu.
    function validCode(code, uid) {
      return exists(codePath(code))
        && get(codePath(code)).data.ownerUid == uid
        && get(codePath(code)).data.expiresAt > request.time;
    }

    // Existe pareamento entre mim e `other`, aceito pelos DOIS lados.
    function acceptedPair(other) {
      return exists(pairPath(other))
        && get(pairPath(other)).data.acceptedBy.hasAll([me(), other]);
    }

    // ----------------------------------------------------------------------
    // 1. Dados do próprio usuário (spec 0022) — INALTERADO.
    // ----------------------------------------------------------------------
    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && me() == uid;
    }

    // ----------------------------------------------------------------------
    // 2. Códigos de pareamento (spec 0023)
    // Documento mínimo de propósito: só uid e validade. Nunca e-mail, nome ou
    // foto — é o que impede procurar alguém por identidade.
    // ----------------------------------------------------------------------
    match /pairingCodes/{code} {
      // Ler um código exige conhecê-lo (foi mostrado numa tela e digitado).
      // Vencido é ilegível mesmo que o documento ainda exista.
      allow get: if signedIn() && resource.data.expiresAt > request.time;

      // `list` serve só ao dono, para limpar os próprios códigos vencidos.
      allow list: if signedIn() && resource.data.ownerUid == me();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['ownerUid', 'createdAt', 'expiresAt'])
        && request.resource.data.ownerUid == me()
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(10, 'm');

      allow delete: if signedIn() && resource.data.ownerUid == me();
      allow update: if false; // gerar outro código cria outro documento
    }

    // ----------------------------------------------------------------------
    // 3. Pareamentos (spec 0023)
    // pairId determinístico: um par de pessoas, um documento, sem duplicata.
    // Estar pareado NÃO dá acesso a dado nenhum — este documento não carrega
    // registro de consumo, só identificadores, apelidos e consentimento.
    // ----------------------------------------------------------------------
    match /pairings/{pairId} {
      function isMember() { return signedIn() && me() in resource.data.uids; }

      allow get: if isMember();
      // Consulta obrigatória: where('uids', 'array-contains', <meu uid>).
      allow list: if isMember();

      // Quem cria é quem DIGITOU o código; a posse é verificada aqui. O pareamento já
      // nasce aceito pelos dois: mostrar o código é o consentimento de quem gerou,
      // digitá-lo é o de quem recebeu — os dois já aconteceram fisicamente antes
      // deste `create`, então uma segunda tela de confirmação só repetiria o que a
      // posse do código já provou. (Antes disto exigia acceptedBy.size()==1 e uma
      // etapa separada de aceite; simplificado a pedido do usuário — ver spec 0023.)
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['uids', 'createdBy', 'createdAt', 'viaCode', 'acceptedBy', 'aliases', 'sharing', 'invites'])
        && request.resource.data.uids.size() == 2
        && request.resource.data.uids[0] < request.resource.data.uids[1]
        && pairId == request.resource.data.uids[0] + '_' + request.resource.data.uids[1]
        && me() in request.resource.data.uids
        && request.resource.data.createdBy == me()
        && request.resource.data.acceptedBy.size() == 2
        && request.resource.data.acceptedBy.hasAll(request.resource.data.uids)
        && request.resource.data.aliases.keys().hasOnly([me()])
        && request.resource.data.sharing.size() == 0
        && request.resource.data.get('invites', {}).size() == 0
        && validCode(
             request.resource.data.viaCode,
             request.resource.data.uids[0] == me()
               ? request.resource.data.uids[1]
               : request.resource.data.uids[0]);

      // Só quatro coisas são possíveis, e sempre sobre si mesmo: acrescentar-se a
      // acceptedBy, mudar o próprio apelido, publicar o próprio ponteiro de
      // compartilhamento e o próprio ponteiro de convites. Ninguém aceita pelo outro
      // nem mexe no apelido alheio.
      // `invites` (spec 0025) pode não existir em pareamentos anteriores a ela, por isso
      // `get('invites', {})`: ler um campo ausente seria erro de avaliação e negaria tudo.
      allow update: if isMember()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['acceptedBy', 'aliases', 'sharing', 'invites'])
        && request.resource.data.acceptedBy.hasAll(resource.data.acceptedBy)
        && request.resource.data.acceptedBy.hasOnly(resource.data.acceptedBy.concat([me()]))
        && request.resource.data.aliases.diff(resource.data.aliases)
             .affectedKeys().hasOnly([me()])
        && request.resource.data.sharing.diff(resource.data.sharing)
             .affectedKeys().hasOnly([me()])
        && request.resource.data.get('invites', {}).diff(resource.data.get('invites', {}))
             .affectedKeys().hasOnly([me()]);

      // Qualquer um dos dois desfaz o pareamento, a qualquer momento.
      allow delete: if isMember();
    }

    // ----------------------------------------------------------------------
    // 4. Compartilhamentos (spec 0023)
    // Um documento por (dono, convidado), com a cópia das doses de UM evento.
    // Escritor único: o dono. Por isso não existe conflito de escrita.
    //
    // O convidado NÃO tem `list`: ele só faz `get` do id que o dono publicou no
    // pareamento. É isso que permite cobrar o vencimento contra o documento
    // real — numa consulta, a regra seria avaliada contra a consulta, e o
    // vencimento viraria decoração.
    // ----------------------------------------------------------------------
    match /shares/{shareId} {
      function isOwner() { return signedIn() && resource.data.ownerUid == me(); }

      allow get: if isOwner()
        || (signedIn()
            && resource.data.viewerUid == me()
            && resource.data.expiresAt > request.time);

      // Consulta obrigatória: where('ownerUid', '==', <meu uid>).
      allow list: if isOwner();

      allow create: if signedIn()
        && request.resource.data.ownerUid == me()
        && request.resource.data.viewerUid is string
        && request.resource.data.viewerUid != me()
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(96, 'h')
        && acceptedPair(request.resource.data.viewerUid);

      allow update: if isOwner()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.viewerUid == resource.data.viewerUid
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt < request.time + duration.value(96, 'h');

      allow delete: if isOwner();
    }

    // ----------------------------------------------------------------------
    // 5. Eventos compartilhados (spec 0025)
    // Uma ficha pequena publicada pelo organizador: nome, horário, quem foi convidado e
    // quem confirmou. NÃO carrega nenhuma dose — quem vê as doses de quem continua
    // sendo `shares`, decisão separada, por pessoa. Quem aceita ganha uma cópia local
    // do evento; depois disso a ocasião é só dele.
    //
    // Escritores: o organizador escreve a ficha e `invited`; cada convidado escreve só
    // a própria presença em `going`. Nenhum convidado pode convidar nem tirar outro.
    // Sem `list` para convidado, pelo mesmo motivo de `shares`: o vencimento só é
    // cobrado contra o documento real, e o id chega pelo ponteiro `invites` do
    // pareamento (`onSnapshot` negado encerra o listener de vez).
    // ----------------------------------------------------------------------
    match /sharedEvents/{eventId} {
      function isHost() { return signedIn() && resource.data.hostUid == me(); }
      function isGuest() {
        return signedIn()
          && me() in resource.data.invited
          && resource.data.expiresAt > request.time;
      }
      function validExpiry(time) {
        return time is timestamp && time > request.time && time < request.time + duration.value(365, 'd');
      }

      allow get: if isHost() || isGuest();

      // Consulta obrigatória: where('hostUid', '==', <meu uid>) — só para o organizador
      // varrer os próprios eventos vencidos.
      allow list: if isHost();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['hostUid', 'name', 'startAt', 'endAt', 'timeZone', 'status',
              'invited', 'going', 'schemaVersion', 'createdAt', 'updatedAt', 'expiresAt'])
        && request.resource.data.hostUid == me()
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80
        && request.resource.data.startAt is number
        && (request.resource.data.endAt == null || request.resource.data.endAt is number)
        && request.resource.data.status == 'active'
        && request.resource.data.invited.size() == 0   // convidar é um passo por pessoa, abaixo
        && request.resource.data.going.size() == 0
        && validExpiry(request.resource.data.expiresAt);

      // Organizador: edita a ficha, cancela, convida UMA pessoa por escrita (regras não
      // têm laço, e cada convite precisa provar amizade aceita pelos dois) e pode retirar
      // convidados. Nunca acrescenta ninguém a `going` — presença é ato de quem vai.
      allow update: if isHost()
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'startAt', 'endAt', 'timeZone', 'status', 'invited', 'going', 'updatedAt', 'expiresAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80
        && request.resource.data.status in ['active', 'cancelled']
        && validExpiry(request.resource.data.expiresAt)
        // Ou nada de novo (igual, ou só retiradas), ou exatamente UMA pessoa a mais, no
        // fim da lista e com amizade aceita pelos dois lados. A lista antiga vazia é caso
        // à parte: a fatia `[0:0]` é negada pelo motor de regras (verificado no emulador),
        // e sem isto o primeiro convidado de qualquer evento seria recusado.
        && (request.resource.data.invited.hasOnly(resource.data.invited)
            || (request.resource.data.invited.size() == resource.data.invited.size() + 1
                && (resource.data.invited.size() == 0
                    || request.resource.data.invited[0:resource.data.invited.size()] == resource.data.invited)
                && acceptedPair(request.resource.data.invited[resource.data.invited.size()])))
        && request.resource.data.going.hasOnly(resource.data.going)
        && request.resource.data.going.hasOnly(request.resource.data.invited);

      // Convidado: só a própria presença, e só enquanto o convite vale. Mesmo padrão de
      // `acceptedBy`: a lista nova só difere da antiga por mim, para mais ou para menos.
      allow update: if isGuest()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['going'])
        && request.resource.data.going.hasOnly(resource.data.going.concat([me()]))
        && resource.data.going.hasOnly(request.resource.data.going.concat([me()]));

      allow delete: if isHost();
    }
  }
}
